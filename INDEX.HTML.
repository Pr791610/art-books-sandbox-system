<script>
const artworks = [
{
id:1,
title:"Golden Peacock",
artist:"Nikolche Manasiev",
price:49,
category:"PREMIUM",
image:"https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?q=80&w=1200&auto=format&fit=crop",
stripe:"https://buy.stripe.com/test_1",
qr:"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://buy.stripe.com/test_1",
description:"Museum certified collector artwork with premium archival presentation and authenticated QR system."
},
{
id:2,
title:"Blue Horse",
artist:"Nikolche Manasiev",
price:120,
category:"VIP",
image:"https://images.unsplash.com/photo-1578301978693-85fa9c0320b9?q=80&w=1200&auto=format&fit=crop",
stripe:"https://buy.stripe.com/test_2",
qr:"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://buy.stripe.com/test_2",
description:"VIP museum edition with collector authentication and direct Stripe integration."
},
{
id:3,
title:"Mystic Eye",
artist:"Nikolche Manasiev",
price:25,
category:"BUDGET",
image:"https://images.unsplash.com/photo-1545239351-1141bd82e8a6?q=80&w=1200&auto=format&fit=crop",
stripe:"https://buy.stripe.com/test_3",
qr:"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://buy.stripe.com/test_3",
description:"Certified art print with QR protected verification and digital museum archive system."
},
{
id:4,
title:"Cosmic Lion",
artist:"Nikolche Manasiev",
price:180,
category:"VIP",
image:"https://images.unsplash.com/photo-1541961017774-22349e4a1262?q=80&w=1200&auto=format&fit=crop",
stripe:"https://buy.stripe.com/test_4",
qr:"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://buy.stripe.com/test_4",
description:"Exclusive museum vault artwork with VIP access and collector status certification."
},
{
id:5,
title:"Royal Phoenix",
artist:"Nikolche Manasiev",
price:85,
category:"PREMIUM",
image:"https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?q=80&w=1200&auto=format&fit=crop",
stripe:"https://buy.stripe.com/test_5",
qr:"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://buy.stripe.com/test_5",
description:"Premium authenticated artwork with collector metadata and secure Stripe payment."
}
];

let filteredArtworks = [...artworks];

function renderArtworks(data = filteredArtworks){
const gallery = document.getElementById('gallery');
gallery.innerHTML = '';

document.getElementById('count').innerText = data.length;

data.forEach(item => {
const card = document.createElement('div');
card.className = 'card';

card.innerHTML = `
<div class="badge">🔒 ${item.category}</div>
<img src="${item.image}" class="art-image">
<div class="card-content">
<h2>#${item.id} ${item.title}</h2>
<div class="artist">Artist: ${item.artist}</div>
<div class="description">${item.description}</div>
<div class="price">€${item.price}</div>

<div class="qr-box">
<img src="${item.qr}">
</div>

<a href="${item.stripe}" target="_blank" class="buy-btn">
BUY NOW
</a>
</div>
`;

gallery.appendChild(card);
});
}

function searchArtworks(){
const value = document.getElementById('search').value.toLowerCase();

filteredArtworks = artworks.filter(item =>
item.title.toLowerCase().includes(value) ||
item.category.toLowerCase().includes(value) ||
item.price.toString().includes(value)
);

renderArtworks(filteredArtworks);
}

function filterCategory(){
const category = document.getElementById('filterCategory').value;

if(category === 'ALL'){
filteredArtworks = [...artworks];
}else{
filteredArtworks = artworks.filter(item => item.category === category);
}

renderArtworks(filteredArtworks);
}

function sortByName(){
filteredArtworks.sort((a,b)=>a.title.localeCompare(b.title));
renderArtworks(filteredArtworks);
}

function sortByLow(){
filteredArtworks.sort((a,b)=>a.price-b.price);
renderArtworks(filteredArtworks);
}

function sortByHigh(){
filteredArtworks.sort((a,b)=>b.price-a.price);
renderArtworks(filteredArtworks);
}

renderArtworks();
</script>

